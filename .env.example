# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o git (ver .gitignore).

# Conexao Postgres do Supabase (OBRIGATORIA).
# Use a connection string do POOLER (Password mode):
# postgresql://postgres.<project-ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Segredo dos tokens JWT (obrigatorio em producao; troque por um valor aleatorio).
JWT_SECRET=

# Protege POST /api/cron/accrue (o Cron da Vercel envia Bearer <CRON_SECRET>).
CRON_SECRET=

# --- Opcionais ---

# 'disable' desliga o SSL (apenas Supabase local via CLI).
# PGSSL=disable

# Tamanho do pool de conexoes do pg (default 5).
# PGPOOL_MAX=5

# Chave demo do CoinGecko (sobe o rate-limit de /api/crypto/prices).
# COINGECKO_API_KEY=

# Chave da CoinMarketCap (opcional).
# CMC_API_KEY=

# RPC Solana para LEITURAS on-chain (Jito/Kamino/portfolio). Default mainnet.
# SOLANA_RPC_URL=

# RPC Solana usado nos PAGAMENTOS/deposito. Default: SOLANA_RPC_URL ou mainnet
# publica (recebe SOL REAL). Para testar sem dinheiro real aponte para devnet:
#   SOLANA_PAY_RPC_URL=https://api.devnet.solana.com
# SOLANA_PAY_RPC_URL=

# Porta do servidor local (default 3000).
# PORT=3000
